// ==========================
// Prisma Configuration
// ==========================
generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==========================
// TENANT (Education Center)
// ==========================
model Tenant {
  id        String   @id @default(cuid())
  name      String
  subdomain String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seatQuota Int      @default(0) // Maximum number of seats this tenant is allowed to allocate overall

  users           User[]
  exams           Exam[]
  tenantSeatUsage TenantSeatUsage?
}

// ==========================
// TENANT SEAT USAGE (Quota Tracker)
// ==========================
model TenantSeatUsage {
  id        String @id @default(cuid())
  tenantId  String @unique
  usedSeats Int    @default(0) // Current number of allocated seats across all exams

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// ==========================
// PLATFORM USERS (Admins / Staff)
// ==========================
enum UserRole {
  PLATFORM_ADMIN
  TENANT_ADMIN
  STAFF
  CANDIDATE
}

model User {
  id        String     @id @default(cuid())
  tenantId  String?
  email     String     @unique
  password  String
  name      String
  roles     UserRole[]
  isDeleted Boolean    @default(false)
  createdAt DateTime   @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
}

// ============================================================================
// TEST CONTENT LIBRARY
// This is the reusable "master copy" of an IELTS test — the thing that used
// to live in JSON files. It is tenant-agnostic: many tenants can run the
// same Test, and running it (an Exam) never mutates it.
// ============================================================================

enum TestType {
  ACADEMIC
  GENERAL_TRAINING
}

model Test {
  id          String   @id @default(cuid())
  title       String // e.g. "Cambridge IELTS 18 — Test 1"
  type        TestType
  version     String? // internal versioning / source attribution
  isPublished Boolean  @default(false) // draft tests shouldn't be selectable for a real Exam
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections   Section[]
  exams      Exam[]
  answerKeys AnswerKey[]
}

enum TestSkill {
  LISTENING
  READING
  WRITING
  SPEAKING
}

model AnswerKey {
  id         String @id @default(cuid())
  testId     String
  questionId String
  answer     Json // string | string[] | object — supports multiple accepted answers
  sectionId  String

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  section  Section  @relation(fields: [sectionId], references: [id])

  @@unique([testId, sectionId, questionId])
}

// One Section per module of a Test (Listening / Reading / Writing / Speaking).
// Holds the module-level timer and instructions; the actual stimulus and
// questions live in the models below, scoped to this part.
model Section {
  id           String    @id @default(cuid())
  testId       String
  skill        TestSkill
  order        Int // 1..4, display/sitting order within the test
  durationSec  Int // default section timer
  instructions String? // top-of-section general instructions

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  passages       Passage[] // populated when section = READING
  audioTracks    AudioTrack[] // populated when section = LISTENING
  questionGroups QuestionGroup[] // populated for every section, including WRITING and SPEAKING
  answerKeys     AnswerKey[]

  @@unique([testId, skill])
}

// ----------------------------------------------------------------------
// READING — the passage text a candidate reads. Content is an ordered
// block array (same shape as QuestionGroup.layout below) so that a
// passage can carry its own headings and labelled paragraphs
// ("A", "B", "C" ...) for question types like Matching Headings /
// Matching Information, which target a specific paragraph rather than
// a specific question.
// ----------------------------------------------------------------------
model Passage {
  id        String  @id @default(cuid())
  sectionId String
  order     Int
  title     String
  content   Json // ordered ContentBlock[] — see layout convention below
  source    String? // attribution / citation

  section        Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questionGroups QuestionGroup[]
  // highlights     Highlight[]
  highlights     Highlight[]

  @@unique([sectionId, order])
}

// ----------------------------------------------------------------------
// LISTENING — the audio a candidate hears. Transcript is optional and
// only used for admin/QA review, never shown to a candidate mid-exam.
// ----------------------------------------------------------------------
model AudioTrack {
  id         String  @id @default(cuid())
  sectionId  String
  order      Int // 1..4, one per Listening part
  title      String?
  audioUrl   String
  transcript Json? // ordered ContentBlock[], admin/QA use only

  section        Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questionGroups QuestionGroup[]

  @@unique([sectionId, order])
}

// ----------------------------------------------------------------------
// QUESTION GROUPS & QUESTIONS
// A QuestionGroup is what the candidate sees as one unit: shared
// instructions ("Questions 1-5"), an optional link to the passage or
// audio track it belongs to, and a `layout` describing exactly how to
// arrange its content and questions on screen. This is what lets the
// same schema represent Form Completion, Table Completion, Matching,
// Diagram Labelling, etc. without a bespoke table per question type.
//
// For WRITING and SPEAKING, sectionId is set but passageId/audioTrackId
// are left null — the task/prompt itself lives on the single Question
// inside the group (see Question.prompt / Question.config below).
// ----------------------------------------------------------------------

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_CHOICE_MULTI_ANSWER
  TRUE_FALSE_NOT_GIVEN
  YES_NO_NOT_GIVEN
  MATCHING_HEADING
  MATCHING_INFORMATION
  MATCHING_FEATURES
  MATCHING_SENTENCE_ENDINGS
  SENTENCE_COMPLETION
  SUMMARY_COMPLETION
  NOTE_COMPLETION
  TABLE_COMPLETION
  FORM_COMPLETION
  FLOW_CHART_COMPLETION
  DIAGRAM_LABELLING
  SHORT_ANSWER
  WRITING_TASK
  SPEAKING_PROMPT
}

model QuestionGroup {
  id           String       @id @default(cuid())
  sectionId    String
  passageId    String?
  audioTrackId String?
  type         QuestionType
  order        Int
  title        String? // "Questions 1-5"
  instructions String // "Complete the notes below. Write NO MORE THAN TWO WORDS..."
  layout       Json // ordered ContentBlock[] — see convention below

  section    Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  passage    Passage?    @relation(fields: [passageId], references: [id])
  audioTrack AudioTrack? @relation(fields: [audioTrackId], references: [id])
  questions  Question[]

  @@unique([sectionId, order])
}

// The atomic, gradable unit. `config` and `correctAnswer` are typed
// loosely (Json) on purpose — a multiple choice question needs an
// options list, a diagram label needs hotspot coordinates, a matching
// question needs a target label — but every one of them ultimately
// resolves to "here is what a correct submitted value looks like".
// correctAnswer is nullable because Writing/Speaking are human-graded,
// not compared against a stored answer key.
model Question {
  id              String  @id @default(cuid())
  questionGroupId String
  order           Int // the candidate-facing number, e.g. 7 for "Question 7"
  prompt          String? // question stem / task prompt; null for pure fill-in items driven by layout labels
  config          Json? // type-specific rendering config: options, blank count, hotspot coords, min word count...
  correctAnswer   Json? // string | string[] | object — supports multiple accepted answers; null for Writing/Speaking
  points          Int     @default(1)

  questionGroup QuestionGroup      @relation(fields: [questionGroupId], references: [id], onDelete: Cascade)
  responses     QuestionResponse[]
  answerKeys    AnswerKey[]

  @@unique([questionGroupId, order])
}

// ============================================================================
// EXAM SITTING
// This is the runtime side: one administration of a Test to a Tenant on a
// given date, with one SectionProgress / QuestionResponse per candidate seat. Content models above are never
// written to once published; everything mutable lives down here.
// ============================================================================

enum ExamStatus {
  SCHEDULED
  OPEN
  IN_PROGRESS
  COMPLETED
}

model ExamSectionProgress {
  id        String     @id @default(cuid())
  status    ExamStatus
  examId    String
  skill     TestSkill
  startedAt DateTime   @default(now())

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model Exam {
  id           String     @id @default(cuid())
  tenantId     String
  testId       String
  examDate     DateTime
  status       ExamStatus @default(SCHEDULED)
  isArchived   Boolean    @default(false)
  startTime    DateTime?
  endTime      DateTime?
  createdAt    DateTime   @default(now())
  currentSkill TestSkill? // the skill currently in progress, if any

  tenant Tenant @relation(fields: [tenantId], references: [id])
  test   Test   @relation(fields: [testId], references: [id])

  seats                 ExamSeat[]
  examSectionProgresses ExamSectionProgress[]
}

// ==========================
// EXAM SEAT (One seat = one candidate = one exam run)
// ==========================
enum ExamSeatStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model ExamSeat {
  id               String         @id @default(cuid())
  tenantId         String
  examId           String
  label            String? // "Row 3, Seat 2"
  accessCode       String         @unique // Candidate login code
  candidateName    String
  candidateId      String
  candidateContact String
  status           ExamSeatStatus @default(NOT_STARTED)
  startedAt        DateTime?
  submittedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  exam     Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  sections SectionProgress[]
}

// ==========================
// SECTION PROGRESS
// A seat's progress through one section. Own status enum — a section
// being "expired" or "completed" is a different concept from a whole
// seat being "submitted".
// ==========================
enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

model SectionProgress {
  id           String         @id @default(cuid())
  seatId       String
  status       ProgressStatus @default(NOT_STARTED)
  startedAt    DateTime?
  submittedAt  DateTime?
  remainingSec Int? // countdown sync

  seat ExamSeat @relation(fields: [seatId], references: [id])

  responses  QuestionResponse[]
  highlights Highlight[]
}

// ==========================
// QUESTION RESPONSE
// Real relation to Question (no more "external JSON id" string). `value`
// is Json so it can hold a single string, an array of blanks, a set of
// matching pairs, or an audio recording reference — whatever shape the
// Question's type requires.
// ==========================
model QuestionResponse {
  id                String    @id @default(cuid())
  sectionProgressId String
  questionId        String
  value             Json? // shape depends on Question.type; null until answered
  wordCount         Int? // writing / long-answer only
  isFlagged         Boolean   @default(false)
  visitedAt         DateTime?
  answeredAt        DateTime?

  sectionProgress SectionProgress @relation(fields: [sectionProgressId], references: [id])
  question        Question        @relation(fields: [questionId], references: [id])
  drafts          WritingDraft[]

  @@unique([sectionProgressId, questionId])
}

// ==========================
// HIGHLIGHT (Reading)
// Scoped to the passage + the candidate's section attempt, not to a
// single question — a highlight is a text selection in the passage and
// may have nothing to do with any one question.
// ==========================
model Highlight {
  id                String @id @default(cuid())
  sectionProgressId String
  passageId         String
  startOffset       Int
  endOffset         Int
  color             String @default("yellow")

  sectionProgress SectionProgress @relation(fields: [sectionProgressId], references: [id])
  passage         Passage         @relation(fields: [passageId], references: [id])
}

// ==========================
// WRITING DRAFT (Autosave)
// ==========================
model WritingDraft {
  id                 String   @id @default(cuid())
  questionResponseId String
  content            String
  wordCount          Int
  savedAt            DateTime @default(now())

  questionResponse QuestionResponse @relation(fields: [questionResponseId], references: [id])
}

// ============================================================================
// LAYOUT / CONTENT BLOCK CONVENTION (documented here, not enforced by
// Prisma — Passage.content, AudioTrack.transcript and QuestionGroup.layout
// all store an ordered array of blocks in this shape):
//
// type ContentBlock =
//   | { kind: "heading"; text: string }
//   | { kind: "subheading"; text: string }
//   | { kind: "paragraph"; text: string; label?: string }   // label = "A","B" for matching-heading passages
//   | { kind: "instruction"; text: string }
//   | { kind: "image"; url: string; alt?: string }
//   | { kind: "question"; questionId: string; label?: string } // inline field, e.g. label: "Name:"
//   | { kind: "table"; columns: string[]; rows: (string | { questionId: string })[][] }
//   | { kind: "list"; items: string[] }                      // option bank for matching tasks
//   | { kind: "divider" };
//
// The frontend renders this array top to bottom. A "question" block never
// carries the question's own data — it only marks where to render the
// input control for Question.id, keeping the Question table the single
// source of truth for type/config/correctAnswer.
// ============================================================================
